{
  "name": "bignuten-contracts",
  "version": "1.0.0",
  "description": "Hardhat toolchain for BigNuten smart contracts ($BNUT token, Treasury, Subscription, Governance)",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:payroll": "node --test test/payroll.test.js test/commentArt.test.js",
    "validate:payroll": "node scripts/validatePayrollQueue.js",
    "storage:serve": "node services/storageRelay.js",
    "test:storage-relay": "node --test test/storageRelay.test.js",
    "network:index": "node scripts/indexBignutenCommunity.js",
    "network:node": "node scripts/bignutenNodeKeeper.js",
    "deploy:network-registry": "hardhat run scripts/deployNetworkRegistry.js --network base",
    "test:scenarios": "hardhat test test/StreakBetEscrow.scenarios.test.js",
    "sim": "hardhat run scripts/streakbot-sim.js",
    "sim:live:estimate": "SIM_PHASE=estimate hardhat run scripts/streakbot-live.js --network optimism",
    "sim:live:setup": "SIM_PHASE=setup hardhat run scripts/streakbot-live.js --network optimism",
    "sim:live:settle": "SIM_PHASE=settle hardhat run scripts/streakbot-live.js --network optimism",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon_mumbai",
    "deploy:base": "hardhat run scripts/deployBase.js --network base",
    "deploy:base:sepolia": "hardhat run scripts/deploy.js --network base_sepolia",
    "deploy:optimism": "hardhat run scripts/deploy.js --network optimism_sepolia",
    "pay:contributor": "hardhat run scripts/payContributor.js --network polygon_mumbai",
    "verify:polygon": "hardhat verify --network polygon_mumbai",
    "verify:base": "hardhat verify --network base_sepolia",
    "verify:optimism": "hardhat verify --network optimism_sepolia",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
